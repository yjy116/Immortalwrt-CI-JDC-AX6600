#!/bin/sh
set -eu

ROOT=${IPKG_INSTROOT:-}
CONFIG_DIR="$ROOT/etc/config"
ROM_DIR="$ROOT/rom/etc/config"
CONFIG="$CONFIG_DIR/athena_led"
ROM_CONFIG="$ROM_DIR/athena_led"
BACKUP_BASE="$CONFIG.config-migrated"

schema() {
	local legacy modern
	legacy=$(uci -c "$1" -q get athena_led.config) || legacy=
	modern=$(uci -c "$1" -q get athena_led.general) || modern=
	case "$legacy:$modern" in
		athena_led:) printf '%s\n' legacy ;;
		:settings) printf '%s\n' modern ;;
		*) return 1 ;;
	esac
}

[ -f "$CONFIG" ] || exit 0
[ -s "$ROM_CONFIG" ] || {
	echo "Athena LED: missing package defaults at $ROM_CONFIG; configuration untouched" >&2
	exit 1
}
expected=$(schema "$ROM_DIR") || {
	echo 'Athena LED: unknown package configuration schema; configuration untouched' >&2
	exit 1
}
current=$(schema "$CONFIG_DIR") || {
	echo 'Athena LED: unknown or mixed current schema; configuration untouched' >&2
	exit 1
}

# Match the installed package, not its age: VIKINGYFY ships config/enable.
# Compatible configs retain custom settings, including an intentional disable.
[ "$current" != "$expected" ] || exit 0

backup="$BACKUP_BASE"
index=0
while [ -e "$backup" ]; do
	index=$((index + 1))
	backup="${BACKUP_BASE}.${index}"
done
cp -p "$CONFIG" "$backup" || exit 1

# Keep the current file intact until the complete replacement is ready.
replacement=$(mktemp "$CONFIG.XXXXXX") || exit 1
trap 'rm -f "$replacement"' EXIT
cp "$ROM_CONFIG" "$replacement" || exit 1
mv -f "$replacement" "$CONFIG" || exit 1
printf 'Athena LED: restored %s package defaults; previous config saved at %s\n' \
	"$expected" "$backup"

# uci-defaults runs during boot before S99athena_led; do not force autostart.
exit 0
