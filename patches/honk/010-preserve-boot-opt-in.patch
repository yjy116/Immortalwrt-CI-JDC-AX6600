@@ -1,7 +1,13 @@
 #!/bin/sh
-# 开机自启是内置行为：装上就 enable，是否真正启动由 honk.main.enabled 决定，
-# 不再提供单独的 boot_enabled 开关。
-/etc/init.d/honk enable
+# Preserve fresh-install and restored boot preferences without starting services.
+. /lib/functions.sh
+config_load honk
+config_get_bool boot_enabled main boot_enabled 0
+if [ "$boot_enabled" -eq 1 ]; then
+	/etc/init.d/honk enable || exit 1
+else
+	/etc/init.d/honk disable || exit 1
+fi
 
 # 配置模式已取消：只清遗留键，活动配置与启停状态一概不动。
 legacy_mode=$(uci -q get honk.main.config_mode 2>/dev/null)
